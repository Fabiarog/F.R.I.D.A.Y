{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F.R.I.D.A.Y.",
  "version": "5.3.1",
  "identifier": "ai.friday.core",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "F.R.I.D.A.Y. Local",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "title": "F.R.I.D.A.Y.",
      "tooltip": "F.R.I.D.A.Y. Local"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../voice/bin/voice-worker.exe": "voice/voice-worker.exe",
      "../voice/.downloads/vosk-model-small-pt-0.3.zip": "voice/model.zip"
    },
    "externalBin": [],
    "copyright": "© 2026 F.R.I.D.A.Y.",
    "category": "Utility",
    "shortDescription": "Assistente desktop local para Windows",
    "longDescription": "Assistente local e leve para abrir aplicativos, controlar mídia, pesquisar e executar automações seguras no Windows.",
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
