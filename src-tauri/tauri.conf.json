{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F.R.I.D.A.Y.",
  "version": "4.2.0",
  "identifier": "ai.friday.core",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "F.R.I.D.A.Y. // CORE v4.2 — Neural Command Interface",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "title": "F.R.I.D.A.Y.",
      "tooltip": "F.R.I.D.A.Y. — Neural Hub Online"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 F.R.I.D.A.Y. Systems",
    "category": "Utility",
    "shortDescription": "Neural AI Command Interface",
    "longDescription": "F.R.I.D.A.Y. — Female Replacement Intelligent Digital Assistant Youth. Sistema de inteligência artificial multiplataforma.",
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
